{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "..",
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["*.ts", "../models/GuestScanReport.ts"],
  "exclude": ["node_modules", "dist"]
}
